---
# yaml-language-server: $schema=https://json.schemastore.org/yamllint.json
extends: default

rules:
  comments:
    min-spaces-from-content: 1

  line-length:
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
    max: 120

ignore:
  - "**/*.sops.yaml"
# vim:ft=yaml
